
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7F3"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sales &amp; Analytics"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#795548"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Sales"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtTotalSales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="£0.00"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#795548"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Orders"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtTotalOrders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Completed Orders"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtCompletedOrders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Average Order Value"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtAverageOrderValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="£0.00"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#795548"
            android:layout_marginBottom="25dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Popular Products"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#795548"
            android:layout_marginBottom="12dp" />


        <LinearLayout
            android:id="@+id/topProductsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Product Recommendation"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#795548"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/txtRecommendation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analysing customer orders..."
            android:textSize="16sp"
            android:textColor="#795548"
            android:background="#EFE8E2"
            android:padding="16dp" />



    </LinearLayout>

</ScrollView>
