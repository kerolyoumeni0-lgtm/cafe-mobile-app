
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7F3"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customer Feedback"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#4E342E"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Review customer ratings and comments."
            android:textSize="15sp"
            android:textColor="#795548"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/txtAverageRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Average rating: 0.0 / 5"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#795548"
            android:padding="12dp" />

        <TextView
            android:id="@+id/txtEmptyFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No customer feedback available."
            android:textSize="16sp"
            android:gravity="center"
            android:padding="25dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/feedbackContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
