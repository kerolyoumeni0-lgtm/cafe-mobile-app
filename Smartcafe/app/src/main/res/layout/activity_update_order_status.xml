
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7F3"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update Order Status"
            android:textColor="#4E342E"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select an order and update its progress."
            android:textColor="#795548"
            android:textSize="15sp"
            android:layout_marginBottom="25dp" />

        <TextView
            android:id="@+id/txtEmptyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No orders available yet."
            android:textColor="#888888"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="25dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/ordersStatusContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
